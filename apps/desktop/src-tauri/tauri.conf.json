{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Coinbox",
  "version": "2.0.0",
  "identifier": "com.coinbox.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Coinbox",
        "width": 1200,
        "height": 800,
        "minWidth": 360,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [],
    "resources": [],
    "category": "Finance",
    "shortDescription": "Statement review and desktop wallets",
    "longDescription": "Review INR bank and credit card statements, match repayments, and export transactions. Coinbox also includes a desktop crypto wallet."
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
